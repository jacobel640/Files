<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_grid_type"
    android:layout_width="120dp"
    android:layout_height="150dp"
    android:layout_margin="4dp"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    app:strokeColor="@color/transparent"
    app:cardElevation="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        >

        <ImageView android:id="@+id/icon_view_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:contentDescription="@string/file" />

        <TextView
            android:id="@+id/icon_view_ext"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:gravity="center"
            android:maxLines="1"
            android:textStyle="bold"
            android:textColor="@color/background"
            android:background="@color/transparent"
            app:autoSizeTextType="uniform"
            android:layout_gravity="center"
            android:visibility="gone"
            android:contentDescription="@string/info" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView android:id="@+id/icon_view_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/folder"
                android:contentDescription="@string/file" />

            <ImageView
                android:id="@+id/icon_view_indicator"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ctg_photo"
                android:contentDescription="@string/info"
                />

            <TextView
                android:id="@+id/count_files"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+20"
                android:textSize="20sp"
                android:background="@color/transparent_gradient"
                android:visibility="gone"
                />

        </FrameLayout>

        <TextView android:id="@+id/file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:text="@string/file"
            android:textSize="12sp"
            android:maxLines="1"
            android:padding="7dp"
            android:gravity="center_horizontal"
            android:background="?attr/colorSurface"
            android:textColor="@color/text"
            />

    </LinearLayout>

    <ImageView
        android:id="@+id/icon_background"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="3dp"
        android:background="@drawable/grey_background"
        android:layout_gravity="center"
        android:visibility="gone"
        android:contentDescription="@string/info" />

    <TextView
        android:id="@+id/file_info"
        android:text="@string/info"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        />

    <TextView
        android:id="@+id/file_size"
        android:text="@string/size"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        />

    <ImageView
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@string/divider" />

    <FrameLayout
        android:id="@+id/icon_view_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <CheckBox
        android:id="@+id/selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />


</com.google.android.material.card.MaterialCardView>