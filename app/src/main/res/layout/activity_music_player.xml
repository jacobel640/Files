<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.MusicPlayerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.9"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/song_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Artist"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:id="@+id/song_album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Song Album"
                    />

            </LinearLayout>

            <ImageView
                android:id="@+id/song_cover"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:src="@drawable/ctg_audio"
                android:scaleType="centerCrop"
                android:background="@drawable/round"
                />

            <TextView
                android:id="@+id/song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:text="Song Title"
                android:textSize="20sp"
                android:textStyle="bold"
                />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/current_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|bottom"
                    android:text="00:00"
                    />

                <TextView
                    android:id="@+id/song_format"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|bottom"
                    android:text="MP3/320KHZ"
                    android:textSize="16sp"
                    />

                <TextView
                    android:id="@+id/song_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:text="04:33"
                    />

            </FrameLayout>

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:layout_gravity="top"
                />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/round"
                android:backgroundTint="@color/background"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                >

                <ImageButton
                    android:id="@+id/btn_previous"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_margin="10dp"
                    android:layout_gravity="start"
                    android:src="@drawable/player_previous"
                    android:scaleType="centerCrop"
                    android:background="@drawable/round_small"
                    android:backgroundTint="@color/transparent_gradient"
                    />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/player_play"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/round_small"
                    android:backgroundTint="@color/transparent_gradient"
                    />

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_margin="10dp"
                    android:layout_gravity="end"
                    android:src="@drawable/player_next"
                    android:scaleType="centerCrop"
                    android:background="@drawable/round_small"
                    android:backgroundTint="@color/transparent_gradient"
                    />

            </FrameLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>