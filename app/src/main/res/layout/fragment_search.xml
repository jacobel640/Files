<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:animateLayoutChanges="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/button_expand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_margin="5dp"
            android:foreground="?android:selectableItemBackground"
            tools:ignore="UseCompoundDrawables"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
            >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:id="@+id/tv_path"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="@string/filters"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    />

                <ImageView
                    android:id="@+id/expand_arrow"
                    android:layout_width="14dp"
                    android:layout_height="12dp"
                    android:src="@drawable/path_arrow"
                    android:contentDescription="@string/path"
                    app:tint="@color/primary" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_gravity="end|center_vertical"
                android:text="@string/items"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/exp_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:layout_marginBottom="7dp"
            app:strokeColor="@color/transparent"
            app:cardElevation="1dp">

            <LinearLayout
                android:id="@+id/filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:id="@+id/folder_chip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp">


                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_gravity="start"
                    android:text="@string/time_title"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/filter_date_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:lineSpacing="0dp"
                    app:chipSpacingVertical="0dp"
                    >

                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/filter_type_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_gravity="start"
                    android:text="@string/sort_type"
                    android:textStyle="bold"
                    android:textColor="@color/text"
                    />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/filter_type_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:lineSpacing="0dp"
                    app:chipSpacingVertical="0dp"
                    >

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_files"
                tools:listitem="@layout/item_file_card"
                android:background="@drawable/round_small"
                android:choiceMode="singleChoice"
                android:divider="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />

            <TextView
                android:id="@+id/no_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/no_files_found"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone"
                android:background="@color/background"
                />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/on_primary"
        app:expanded="false" >

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbarLayout"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:fitsSystemWindows="true"
            app:expandedTitleTextColor="@color/transparent"
            app:layout_scrollFlags="scroll|snap|exitUntilCollapsed"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search"
                android:layout_gravity="top"
                android:gravity="center"
                android:textSize="35sp"
                android:paddingTop="50dp"
                android:paddingBottom="50dp"
                android:textColor="@color/primary"
                app:layout_collapseMode="parallax"
                />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="bottom"
                app:layout_collapseMode="pin" >

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="15dp"
                    app:strokeColor="@color/transparent">

                    <EditText
                        android:id="@+id/search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:hint="@string/search"
                        android:paddingStart="50dp"
                        android:paddingEnd="40dp"
                        android:textSize="20sp"
                        android:padding="10dp"
                        android:singleLine="true"
                        android:inputType=""
                        style="@style/Widget.Material3.TextInputEditText.OutlinedBox"
                        tools:ignore="Autofill,RtlSymmetry" />

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/back"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/round_only"
                        android:foreground="?android:selectableItemBackground"
                        android:contentDescription="@string/back" />

                    <ImageButton
                        android:id="@+id/btnClear"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/clear"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/round_only"
                        android:foreground="?android:selectableItemBackground"
                        android:contentDescription="@string/back"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:indeterminate="true"
                        android:layout_marginBottom="-8dp"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        />

                </com.google.android.material.card.MaterialCardView>

            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>