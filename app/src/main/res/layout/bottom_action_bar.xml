<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/bottom_action_bar"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:layout_gravity="bottom"
    android:gravity="bottom"
    android:animateLayoutChanges="true"
    android:baselineAligned="false"
    android:background="@color/primary_container"
    app:strokeColor="@color/transparent"
    app:cardCornerRadius="15dp"
    app:cardElevation="1dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="5dp"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/move"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="60dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/round_only"
            android:foreground="?android:selectableItemBackground"
            >
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/action_move"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/move"
                android:gravity="center"
                android:textColor="@color/on_primary_container"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/copy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="60dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/round_only"
            android:foreground="?android:selectableItemBackground"
            >
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/action_copy"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copy_action"
                android:gravity="center"
                android:textColor="@color/on_primary_container"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/details"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="60dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/round_only"
            android:foreground="?android:selectableItemBackground"
            >
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/action_details"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/details"
                android:gravity="center"
                android:textColor="@color/on_primary_container"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/share"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="60dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/round_only"
            android:foreground="?android:selectableItemBackground"
            >
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/action_share"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/share"
                android:gravity="center"
                android:textColor="@color/on_primary_container"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/delete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="60dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/round_only"
            android:foreground="?android:selectableItemBackground"
            >
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/action_delete"
                android:contentDescription="@string/delete" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:gravity="center"
                android:textColor="@color/on_primary_container"
                />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout android:id="@+id/copy_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/round_small"
        android:backgroundTint="@color/secondary_container"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <TextView android:id="@+id/items"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/items"
            android:textStyle="bold"
            android:textColor="@color/on_secondary_container"
            android:layout_height="wrap_content"
            />

        <Button android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:maxLines="1"
            android:padding="8dp"
            android:textSize="17sp"
            android:textStyle="bold"
            style="@style/Widget.Material3.Button.TextButton"
            />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            />

        <Button android:id="@+id/copy_here"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/copy_here"
            android:maxLines="1"
            android:padding="8dp"
            android:textSize="17sp"
            android:textStyle="bold"
            style="@style/Widget.Material3.Button.TextButton"
            />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>