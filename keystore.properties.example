# Template for release signing credentials.
#
# Copy this file to `keystore.properties` in the project root and fill in your
# own values. `keystore.properties` is listed in .gitignore and must never be
# committed.
#
# Alternatively, leave the file out entirely and export these environment
# variables instead (useful for CI):
#   FILES_KEYSTORE_FILE, FILES_KEYSTORE_PASSWORD, FILES_KEY_ALIAS, FILES_KEY_PASSWORD
#
# If neither the file nor the variables are present, the release build simply
# stays unsigned instead of failing.

storeFile=/absolute/path/to/your/key.jks
storePassword=
keyAlias=
keyPassword=
